{
  "name": "turquoise",
  "private": true,
  "version": "0.0.0",
  "description": "Turquoise Reading App",
  "author": "Turquoise Team",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "markdown-it": "^14.1.1",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-electron": "^0.29.1",
    "vue-tsc": "^3.2.5"
  },
  "build": {
    "appId": "com.turquoise.app",
    "productName": "Turquoise",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "electron/**/*"
    ],
    "asar": false
  }
}
